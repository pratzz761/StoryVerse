# Set in Vercel with project Root Directory = frontend. Redeploy after changes.
STORYVERSE_PUBLIC_DEPLOYMENT=true
API_INTERNAL_URL=https://YOUR_BACKEND.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public publishable key or legacy anon JWT only. NEVER a secret/service-role key, Gemini key or worker token.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
