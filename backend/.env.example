# demo: local SQLite + local files, shared demo persona. supabase: real accounts + PostgreSQL + Storage.
APP_MODE=demo
APP_ENVIRONMENT=development
# Deployment templates: .env.production.example and .worker.env.example.
# Local mode preserves direct ComfyUI; cloud deployments use an outbound worker.
SDXL_EXECUTION=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATA_DIR=data
MAX_UPLOAD_BYTES=20971520

# AI is independent of persistence. Primary: amd; explicit fallback: gemini; off: demo.
# No automatic fallback: an AMD failure never sends your story to Gemini.
AI_MODE=amd
# Backend only. Obtain the key from AMD Radeon Cloud Token Factory, not tokenfactory.cn.
AMD_API_KEY=
AMD_MODEL=DeepSeek-V4-Flash
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Model availability, free eligibility and JSON capability are checked against /models.
# Backend environment/backend/.env only; keep this template blank and never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true ONLY after checking that this key belongs to an UNPAID/free-tier project.
# An API key cannot tell the app whether your Google project has billing enabled.
GEMINI_FREE_TIER_CONFIRMED=false
# Supabase mode: secret key (sb_secret_) or legacy service_role JWT, backend ONLY.
# Needed for protected AI job RPCs. SUPABASE_ANON_KEY accepts a publishable key or legacy anon JWT.
# Existing user data access continues to use the caller JWT and RLS.
SUPABASE_SERVICE_ROLE_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=4096
AI_CONTEXT_CHARS=18000
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=100
AI_REQUESTS_PER_MINUTE=2
AI_GLOBAL_CONCURRENCY=2

# Optional LOCAL SDXL images; independent of Gemini. No paid image APIs.
# Default off: retain clearly labeled panel-description placeholders.
SDXL_ENABLED=false
# a1111: AUTOMATIC1111 --api; comfyui: native API; generic: local /health + /generate.
# All three adapters are documented in docs/local-sdxl.md.
SDXL_API_FLAVOR=a1111
# Loopback origin only. Runtime must run alongside FastAPI; redirects/proxies disabled.
SDXL_BASE_URL=http://127.0.0.1:7860
# A1111: already selected checkpoint. ComfyUI: exact installed models/checkpoints name.
# ComfyUI loads this installed checkpoint in its workflow; no weights are downloaded.
SDXL_MODEL=sd_xl_base_1.0.safetensors
# Conservative starting point for RTX 4050. Multiples of 64, <=1024.
# Batch size/n_iter are fixed at 1; no refiner or high-resolution pass.
# A1111: --medvram-sdxl. ComfyUI: runtime --lowvram/offloading; see the guide.
SDXL_WIDTH=768
SDXL_HEIGHT=768
SDXL_STEPS=20
SDXL_CFG_SCALE=6
SDXL_SAMPLER=DPM++ 2M
SDXL_TIMEOUT_SECONDS=120
SDXL_SEED=42
SDXL_NEGATIVE_PROMPT=blurry, low quality, watermark, text, logo, distorted anatomy

# Native ComfyUI only: set SDXL_API_FLAVOR=comfyui and SDXL_BASE_URL=http://127.0.0.1:8188.
# Actual local configuration/results: docs/live-comfyui-validation.md (300s cold-load timeout).
# Uses a built-in SDXL base workflow, tiled VAE decode and one temporary preview PNG.
# Native names are independent of the A1111/generic SDXL_SAMPLER above.
COMFYUI_SAMPLER=dpmpp_2m
COMFYUI_SCHEDULER=karras
# Polling reads execution status; it never re-submits a workflow.
# Includes queueing and retrieval inside SDXL_TIMEOUT_SECONDS (max 300).
COMFYUI_POLL_INTERVAL_SECONDS=1
