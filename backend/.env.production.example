# Render only. Never paste these secrets into frontend variables or source control.
APP_ENVIRONMENT=production
APP_MODE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (sb_publishable_) or legacy anon JWT.
SUPABASE_ANON_KEY=
# Private secret key (sb_secret_) or legacy service-role JWT.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=["https://YOUR_FRONTEND.vercel.app"]
# Keep paused until migrations, email confirmation and a moderator are configured.
PUBLIC_WRITES_ENABLED=false
MODERATION_READY=false
MAX_UPLOAD_BYTES=4194304
AI_MODE=amd
AMD_API_KEY=
AMD_MODEL=DeepSeek-V4-Flash
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Explicit fallback: change AI_MODE to gemini and configure the unpaid project below.
# No automatic provider failover or additional paid model calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
AI_TIMEOUT_SECONDS=45
AI_USER_DAILY_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=25
AI_REQUESTS_PER_MINUTE=1
AI_GLOBAL_CONCURRENCY=2
# Keep disabled until the outbound Windows worker is authenticated and tested.
SDXL_ENABLED=false
SDXL_EXECUTION=worker
SDXL_API_FLAVOR=comfyui
SDXL_MODEL=sd_xl_base_1.0.safetensors
SDXL_WIDTH=768
SDXL_HEIGHT=768
SDXL_STEPS=20
SDXL_CFG_SCALE=6
WORKER_TOKEN=
WORKER_LEASE_SECONDS=300
WORKER_ONLINE_SECONDS=45
