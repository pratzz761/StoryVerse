# Copy to .worker.env on the Windows GPU PC; do not overwrite backend/.env.
WORKER_BACKEND_URL=https://YOUR_BACKEND.onrender.com
# Copy the generated Render WORKER_TOKEN privately. >=32 random characters.
WORKER_TOKEN=
# Generate once with: python -c "import uuid; print(uuid.uuid4())"
WORKER_ID=
WORKER_POLL_SECONDS=5
WORKER_SPOOL_DIR=data/worker-spool
SDXL_ENABLED=true
SDXL_API_FLAVOR=comfyui
SDXL_BASE_URL=http://127.0.0.1:8188
SDXL_MODEL=sd_xl_base_1.0.safetensors
SDXL_WIDTH=768
SDXL_HEIGHT=768
SDXL_STEPS=20
SDXL_CFG_SCALE=6
SDXL_TIMEOUT_SECONDS=240
COMFYUI_SAMPLER=dpmpp_2m
COMFYUI_SCHEDULER=karras
